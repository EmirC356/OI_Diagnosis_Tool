nceCode":"IDA","goId":"GO:0048407","name":"platelet-derived growth factor binding","qualifier":"enables"},{"evidenceCode":"IPI","goId":"GO:0002020","name":"protease binding","qualifier":"enables"},{"evidenceCode":"IPI","goId":"GO:0005515","name":"protein binding","qualifier":"enables"}]},"nomenclatureAuthority":{"authority":"HGNC","identifier":"HGNC:2197"},"omimIds":["120150"],"orientation":"minus","proteinCount":7,"referenceStandards":[{"geneRange":{"accessionVersion":"NG_007400.1","range":[{"begin":"5001","end":"22544","orientation":"plus"}]},"type":"REFSEQ_GENE"}],"summary":[{"description":"This gene encodes the pro-alpha1 chains of type I collagen whose triple helix comprises two alpha1 chains and one alpha2 chain. Type I is a fibril-forming collagen found in most connective tissues and is abundant in bone, cornea, dermis and tendon. Mutations in this gene are associated with osteogenesis imperfecta types I-IV, Ehlers-Danlos syndrome type VIIA, Ehlers-Danlos syndrome Classical type, Caffey Disease and idiopathic osteoporosis. Reciprocal translocations between chromosomes 17 and 22, where this gene and the gene for platelet-derived growth factor beta are located, are associated with a particular type of skin tumor called dermatofibrosarcoma protuberans, resulting from unregulated expression of the growth factor. Two transcripts, resulting from the use of alternate polyadenylation signals, have been identified for this gene. [provided by R. Dalgleish, Feb 2008]"}],"swissProtAccessions":["P02452"],"symbol":"COL1A1","synonyms":["OI1","OI2","OI3","OI4","EDSC","CAFYD","EDSARTH1"],"taxId":"9606","taxname":"Homo sapiens","transcriptCount":7,"transcriptTypeCounts":[{"count":1,"type":"PROTEIN_CODING"},{"count":6,"type":"PROTEIN_CODING_MODEL"}],"type":"PROTEIN_CODING"}
